{
  "name": "corporate-taxid-checker-js",
  "version": "2.1.0",
  "description": "Validate tax identification numbers (TIN, VAT, EIN, GST, ITIN, SSN) for 76+ countries. Regex, checksum, and online VIES/government verification. TypeScript-first with LLM tool definitions.",
  "main": "lib/index.js",
  "browser": "dist/corporate-taxid-checker.js",
  "types": "types/index.d.ts",
  "module": "esm/index.mjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./types/tools.d.ts",
      "require": "./lib/tools.js",
      "default": "./lib/tools.js"
    }
  },
  "files": [
    "lib/",
    "dist/",
    "esm/",
    "types/"
  ],
  "keywords": [
    "tax",
    "tax-id",
    "tax-number",
    "tax-id-validation",
    "TIN",
    "VAT",
    "vat-number",
    "vat-validation",
    "VATIN",
    "VIES",
    "EIN",
    "GST",
    "ITIN",
    "SSN",
    "taxpayer",
    "validation",
    "validator",
    "number",
    "identification",
    "compliance",
    "checksum",
    "finance",
    "typescript",
    "javascript",
    "node.js",
    "EU",
    "international",
    "company"
  ],
  "scripts": {
    "test": "jest",
    "build:lib": "webpack --config webpack.node.cjs",
    "build:dist": "webpack --config webpack.browser.cjs",
    "build:esm": "webpack --config webpack.esm.cjs",
    "build:tools": "webpack --config webpack.tools.cjs",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "npm run build:lib && npm run build:dist && npm run build:esm && npm run build:tools && npm run build:types",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashishvanand/corporate-taxid-checker-js.git"
  },
  "author": "Aashish Vivekanand",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/aashishvanand/corporate-taxid-checker-js/issues"
  },
  "homepage": "https://github.com/aashishvanand/corporate-taxid-checker-js#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "jsonpack": "^2.0.0"
  },
  "optionalDependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/jsonpack": "^1.1.6",
    "@types/node": "^26.4.0",
    "jest": "^30.5.0",
    "path-browserify": "^1.0.1",
    "raw-loader": "^4.0.2",
    "swc-loader": "^0.2.7",
    "typescript": "^7.0.2",
    "webpack": "^5.110.2",
    "webpack-cli": "^7.2.3"
  },
  "overrides": {
    "js-yaml": "^3.15.0",
    "@babel/core": "^7.29.6"
  }
}
